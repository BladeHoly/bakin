{
  "manifest_version": 3,
  "name": "Descargar con Bakin",
  "short_name": "Bakin",
  "version": "1.1.0",
  "description": "Manda la página, un enlace, un video o un audio a Bakin para descargarlo, y si quieres, tu sesión de YouTube. Bakin te pide confirmar antes de bajar nada.",
  "homepage_url": "https://github.com/BladeHoly/bakin",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Descargar esta página con Bakin",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bakin@bladeholy",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
